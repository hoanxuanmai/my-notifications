# Frontend .env example (Next.js)
# Copy to .env.local for local dev, or set these
# keys in your hosting dashboard for production.

# ── API base URL ────────────────────────────────────
# Local backend: http://localhost:3000/api
# Production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── WebSocket base URL ──────────────────────────────
# Same host as backend, without /api
# Local: http://localhost:3000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ── Web Push (VAPID) ────────────────────────────────
# The PUBLIC half of the VAPID key pair. It is shipped to browsers, so it is
# not a secret, but it MUST be the exact pair of the private key configured on
# the Supabase Edge Function (VAPID_PRIVATE_KEY / WEB_PUSH_PRIVATE_KEY).
# Current project value:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BG65sWfBANDP2BqNJOZ9Gcp2tNBltPQfultl24RAZs-Kg60cIeqaiwToY1tZDtQuscFXfvgHj27T9qtqRHGC5mU

# ── Service Worker version (optional) ───────────────
# Bump this to force clients to update /sw.js
NEXT_PUBLIC_SW_VERSION=1
